# Copy to .env.local for local development. Never commit real keys.
# Set ONE of these keys (the app picks whichever is set):
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# LLM_PROVIDER=openai          # openai | gemini | anthropic (needed only if several keys are set)
# LLM_MODEL=gpt-4o-mini        # defaults: gpt-4o-mini / gemini-2.5-flash / claude-sonnet-5-5
# SYSTEM_PROMPT=You are a friendly, helpful assistant.
