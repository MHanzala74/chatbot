# Copy to .env.local for local development. Never commit real keys.
# Set ONE LLM key (the app picks whichever is set):
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional chatbot configuration
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# SYSTEM_PROMPT=You are a friendly, helpful assistant.

# Optional Sentry error monitoring. Use the same project DSN in both variables.
# SENTRY_DSN=                 # server-side errors
# NEXT_PUBLIC_SENTRY_DSN=     # browser-side errors (public DSN only)

# Temps injects OTEL_EXPORTER_OTLP_ENDPOINT, protocol and auth headers at runtime.
# Do not copy OTEL auth headers or private ingest tokens into this file.
# Local development has OTLP exporters disabled unless an endpoint is configured.
# OTEL_SERVICE_NAME=temps-chatbot
